{
  "policies": {
    "protected-branches": {
      "name": "Protect default and stable branches",
      "target": "branch",
      "enforcement": "active",
      "bypass_actors": [
        {
          "actor_id": 0,
          "actor_type": "OrganizationAdmin",
          "bypass_mode": "pull_request"
        },
        {
          "actor_id": 11527171,
          "actor_type": "Team",
          "bypass_mode": "pull_request"
        }
      ],
      "conditions": {
        "ref_name": {
          "include": [
            "~DEFAULT_BRANCH",
            "refs/heads/stable*"
          ],
          "exclude": []
        }
      },
      "rules": [
        {
          "type": "deletion"
        },
        {
          "type": "non_fast_forward"
        },
        {
          "type": "pull_request",
          "parameters": {
            "allowed_merge_methods": [
              "merge",
              "squash",
              "rebase"
            ],
            "dismiss_stale_reviews_on_push": true,
            "require_code_owner_review": true,
            "require_last_push_approval": false,
            "required_approving_review_count": 1,
            "required_review_thread_resolution": true
          }
        }
      ]
    },
    "governance-ci": {
      "name": "Require governance CI",
      "target": "branch",
      "enforcement": "active",
      "bypass_actors": [
        {
          "actor_id": 0,
          "actor_type": "OrganizationAdmin",
          "bypass_mode": "pull_request"
        }
      ],
      "conditions": {
        "ref_name": {
          "include": [
            "~DEFAULT_BRANCH"
          ],
          "exclude": []
        }
      },
      "rules": [
        {
          "type": "required_status_checks",
          "parameters": {
            "required_status_checks": [
              {
                "context": "DCO"
              },
              {
                "context": "actionlint"
              },
              {
                "context": "REUSE Compliance Check"
              },
              {
                "context": "TypeScript"
              },
              {
                "context": "Vitest"
              },
              {
                "context": "zizmor"
              },
              {
                "context": "CodeQL"
              }
            ],
            "strict_required_status_checks_policy": true,
            "do_not_enforce_on_create": false
          }
        }
      ]
    },
    "required-ci-gate": {
      "name": "Require CI",
      "target": "branch",
      "enforcement": "disabled",
      "bypass_actors": [
        {
          "actor_id": 0,
          "actor_type": "OrganizationAdmin",
          "bypass_mode": "pull_request"
        }
      ],
      "conditions": {
        "ref_name": {
          "include": [
            "~DEFAULT_BRANCH"
          ],
          "exclude": []
        }
      },
      "rules": [
        {
          "type": "required_status_checks",
          "parameters": {
            "required_status_checks": [
              {
                "context": "ci-required"
              }
            ],
            "strict_required_status_checks_policy": true,
            "do_not_enforce_on_create": false
          }
        }
      ]
    },
    "organization-config-ci": {
      "name": "Require organization configuration CI",
      "target": "branch",
      "enforcement": "active",
      "bypass_actors": [
        {
          "actor_id": 0,
          "actor_type": "OrganizationAdmin",
          "bypass_mode": "pull_request"
        }
      ],
      "conditions": {
        "ref_name": {
          "include": [
            "~DEFAULT_BRANCH"
          ],
          "exclude": []
        }
      },
      "rules": [
        {
          "type": "required_status_checks",
          "parameters": {
            "required_status_checks": [
              {
                "context": "DCO"
              },
              {
                "context": "actionlint"
              },
              {
                "context": "zizmor"
              }
            ],
            "strict_required_status_checks_policy": true,
            "do_not_enforce_on_create": false
          }
        }
      ]
    }
  },
  "defaults": {
    "policies": [
      "protected-branches"
    ]
  },
  "conditions": [
    {
      "when": {
        "file_exists": "appinfo/info.xml"
      },
      "add_bypass_actors": {
        "protected-branches": [
          {
            "actor_id": 20296731,
            "actor_type": "User",
            "bypass_mode": "always"
          }
        ]
      }
    }
  ],
  "repositories": {
    "LibreCodeCoop/github-governance": {
      "policies": [
        "governance-ci"
      ]
    },
    "LibreCodeCoop/release-tool": {
      "policies": [
        "required-ci-gate"
      ]
    },
    "LibreCodeCoop/nextcloud-docker-development": {
      "policies": [
        "required-ci-gate"
      ]
    },
    "LibreCodeCoop/.github": {
      "policies": [
        "organization-config-ci"
      ]
    },
    "LibreCodeCoop/akaunting-mcp": {
      "rulesets": [
        {
          "name": "Akaunting MCP required CI and signatures",
          "target": "branch",
          "enforcement": "active",
          "bypass_actors": [
            {
              "actor_id": 0,
              "actor_type": "OrganizationAdmin",
              "bypass_mode": "pull_request"
            },
            {
              "actor_id": 11527171,
              "actor_type": "Team",
              "bypass_mode": "pull_request"
            }
          ],
          "conditions": {
            "ref_name": {
              "include": [
                "~DEFAULT_BRANCH"
              ],
              "exclude": []
            }
          },
          "rules": [
            {
              "type": "required_status_checks",
              "parameters": {
                "required_status_checks": [
                  {
                    "context": "GitHub Actions security analysis",
                    "integration_id": 15368
                  },
                  {
                    "context": "GitHub Actions syntax and expressions",
                    "integration_id": 15368
                  },
                  {
                    "context": "Validate manifest, lock and security advisories",
                    "integration_id": 15368
                  },
                  {
                    "context": "Synthetic MCP, OAuth and private Compose topology",
                    "integration_id": 15368
                  },
                  {
                    "context": "PHP 8.5 syntax",
                    "integration_id": 15368
                  },
                  {
                    "context": "PHP-CS-Fixer",
                    "integration_id": 15368
                  },
                  {
                    "context": "PHPStan PHP 8.5",
                    "integration_id": 15368
                  },
                  {
                    "context": "PHPUnit PHP 8.5",
                    "integration_id": 15368
                  },
                  {
                    "context": "SPDX provenance and licensing",
                    "integration_id": 15368
                  },
                  {
                    "context": "Public source and metadata boundaries",
                    "integration_id": 15368
                  },
                  {
                    "context": "gitleaks",
                    "integration_id": 15368
                  },
                  {
                    "context": "Shell script quality",
                    "integration_id": 15368
                  },
                  {
                    "context": "DCO on each PR commit",
                    "integration_id": 15368
                  },
                  {
                    "context": "Conventional Commits on each PR commit",
                    "integration_id": 15368
                  }
                ],
                "strict_required_status_checks_policy": true,
                "do_not_enforce_on_create": false
              }
            },
            {
              "type": "required_signatures"
            }
          ]
        }
      ]
    },
    "LibreCodeCoop/suitecrm-mcp": {
      "rulesets": [
        {
          "name": "SuiteCRM MCP required CI and signatures",
          "target": "branch",
          "enforcement": "active",
          "bypass_actors": [
            {
              "actor_id": 0,
              "actor_type": "OrganizationAdmin",
              "bypass_mode": "pull_request"
            },
            {
              "actor_id": 11527171,
              "actor_type": "Team",
              "bypass_mode": "pull_request"
            }
          ],
          "conditions": {
            "ref_name": {
              "include": [
                "~DEFAULT_BRANCH"
              ],
              "exclude": []
            }
          },
          "rules": [
            {
              "type": "required_status_checks",
              "parameters": {
                "required_status_checks": [
                  {
                    "context": "PHPUnit PHP 8.5",
                    "integration_id": 15368
                  },
                  {
                    "context": "PHPStan analysis",
                    "integration_id": 15368
                  },
                  {
                    "context": "Composer validate and audit",
                    "integration_id": 15368
                  },
                  {
                    "context": "Offline synthetic MCP and OAuth",
                    "integration_id": 15368
                  },
                  {
                    "context": "REUSE licensing",
                    "integration_id": 15368
                  },
                  {
                    "context": "Zizmor security checks",
                    "integration_id": 15368
                  },
                  {
                    "context": "DCO sign-off"
                  },
                  {
                    "context": "Conventional Commits"
                  }
                ],
                "strict_required_status_checks_policy": true,
                "do_not_enforce_on_create": false
              }
            },
            {
              "type": "required_signatures"
            }
          ]
        }
      ]
    }
  }
}
