@@ -183,6 +188,33 @@
           cd ${{ env.APP_NAME }}/build/artifacts
           tar -zcvf ${{ env.APP_NAME }}.tar.gz ${{ env.APP_NAME }}
 
+      - name: Set up PHP 8.3 for release-tool
+        uses: shivammathur/setup-php@f3e473d116dcccaddc5834248c87452386958240 # 2.37.2
+        with:
+          php-version: '8.3'
+          coverage: none
+
+      - id: release-tool
+        name: Setup release-tool v0.11.1
+        shell: bash
+        run: |
+          set -euo pipefail
+          base="https://github.com/LibreCodeCoop/release-tool/releases/download/v0.11.1"
+          curl --fail --silent --show-error --location "${base}/release-tool.phar" -o "${RUNNER_TEMP}/release-tool.phar"
+          curl --fail --silent --show-error --location "${base}/release-tool.phar.sha256" -o "${RUNNER_TEMP}/release-tool.phar.sha256"
+          (cd "${RUNNER_TEMP}" && sha256sum --check release-tool.phar.sha256)
+          echo "path=${RUNNER_TEMP}/release-tool.phar" >> "${GITHUB_OUTPUT}"
+
+      - name: Validate release artifact
+        shell: bash
+        env:
+          RELEASE_TOOL_PATH: ${{ steps.release-tool.outputs.path }}
+        run: >-
+          php "${RELEASE_TOOL_PATH}" artifact:validate-package
+          --artifact "${APP_NAME}/build/artifacts/${APP_NAME}.tar.gz"
+          --app-name "${APP_NAME}"
+          --expected-version "${APP_VERSION}"
+
       - name: Attach tarball to github release
         uses: svenstaro/upload-release-action@29e53e917877a24fad85510ded594ab3c9ca12de # 2.11.5
         id: attach_to_release
