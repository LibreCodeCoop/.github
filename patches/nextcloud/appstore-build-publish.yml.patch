+
+      - name: Verify App Store publication
+        shell: bash
+        env:
+          RELEASE_TOOL_PATH: ${{ steps.release-tool.outputs.path }}
+          NEXTCLOUD_PLATFORM: ${{ fromJSON(steps.appinfo.outputs.result).nextcloud.min-version }}
+        run: >-
+          php "${RELEASE_TOOL_PATH}" publication:wait-appstore
+          --app-name "${APP_NAME}"
+          --version "${APP_VERSION}"
+          --platform "${NEXTCLOUD_PLATFORM}"
